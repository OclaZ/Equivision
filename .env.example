# Backend Configuration
BACKEND_PORT=8000
FRONTEND_PORT=3000
JWT_SECRET_KEY=change-me-to-a-random-64-char-string

# Database Configuration (PostgreSQL — shared by App, Airflow, MLflow)
POSTGRES_USER=equivision_user
POSTGRES_PASSWORD=equivision_password
POSTGRES_DB=equivision_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://equivision_user:equivision_password@localhost:5432/equivision_db

# Redis Configuration (Cache + Airflow Celery broker)
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# MLflow Configuration
MLFLOW_PORT=5000

# Airflow Configuration
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_FERNET_KEY=

# Monitoring Configuration
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
